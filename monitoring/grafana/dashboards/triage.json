{
  "uid": "electricity-triage",
  "title": "Electricity Triage / AgentOps",
  "schemaVersion": 40,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "End-to-end p50 / p95 (seconds)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(triage_run_seconds_bucket[5m])) by (le))",
          "refId": "A",
          "legendFormat": "{{agent}} {{kind}} {{status}} {{outcome}} {{name}} {{job}} {{metric}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(triage_run_seconds_bucket[5m])) by (le))",
          "refId": "B",
          "legendFormat": "{{agent}} {{kind}} {{status}} {{outcome}} {{name}} {{job}} {{metric}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "Terminal throughput (runs/s)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(triage_runs_total[5m])) by (status)",
          "refId": "A",
          "legendFormat": "{{agent}} {{kind}} {{status}} {{outcome}} {{name}} {{job}} {{metric}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "HTTP error fraction",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(triage_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(triage_http_requests_total[5m])), 0.001)",
          "refId": "A",
          "legendFormat": "{{agent}} {{kind}} {{status}} {{outcome}} {{name}} {{job}} {{metric}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      }
    },
