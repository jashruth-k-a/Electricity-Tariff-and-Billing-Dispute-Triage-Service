# Copy to .env. These are local-demo values only; replace secrets before enabling production.
APP_MODE=demo
REDIS_URL=redis://redis:6379/0
CHROMA_HOST=chroma
CHROMA_PORT=8000
VERIFIER_URL=http://verifier:8000
LLM_BASE_URL=http://llm-stub:8000/v1
LLM_MODEL=deterministic-teaching-fixture
LLM_API_KEY=
INTERNAL_TOKEN=local-demo-change-this-token-2026
API_CLIENT_KEYS=
EMBEDDING_BACKEND=hash
EMBEDDING_MODEL=
